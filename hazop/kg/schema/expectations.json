{
  "rules_version": "0.1.0",
  "basis_levels": [
    {"id": "standard", "label_ko": "[표준 원문]"},
    {"id": "secondary", "label_ko": "[2차 출처]"},
    {"id": "excerpt", "label_ko": "[검색 발췌]"},
    {"id": "general", "label_ko": "[일반지식]"},
    {"id": "existing", "label_ko": "[기존 미확인 항목]"}
  ],
  "rules": [
    {"id": "E01", "version": 1, "label_ko": "펌프 출구 역류 방지 체크밸브",
     "target": {"classes": ["pump"]},
     "check": {"type": "neighbor", "relations": ["has_endpoint"], "hops": 3, "stop_at": ["equipment"],
               "need": [{"classes": ["check_valve"]}], "mark_direction": true},
     "hazop_ko": "역류 편차의 보호수단·원인",
     "basis_level": "general",
     "basis_ko": "펌프 정지·병렬 운전 때 역류를 막도록 출구에 체크밸브를 두는 설계 관행. 흐름 방향이 확인되면 하류 여부만 표시하고 후보를 버리지 않음"},
    {"id": "E02", "version": 1, "label_ko": "압력 경계 설비 과압 보호수단(안전밸브·방출밸브·파열판)",
     "target": {"classes": ["vessel", "tank", "pressurizer", "heat_exchanger"]},
     "check": {"type": "neighbor", "relations": ["has_endpoint"], "hops": 3, "stop_at": ["equipment"],
               "need": [{"classes": ["psv", "relief_valve", "rupture_disc"]}]},
     "hazop_ko": "압력 증가 편차의 보호수단. 부재 확정이면 원인·권고 검토 단서",
     "basis_level": "general",
     "basis_ko": "압력용기 과압 보호는 ASME 규격 요구로 알려져 있으나 조항 원문은 확인하지 않음. 보호 대상 관계(protects)가 아직 레지스트리에 없어 물리 연결로만 찾음"},
    {"id": "E03", "version": 1, "label_ko": "탱크·용기 수위 계측",
     "target": {"classes": ["tank", "vessel"]},
     "check": {"type": "neighbor", "relations": ["measurement_connection"], "hops": 1,
               "need": [{"classes": ["instrument"], "property": "measured_variable", "values": ["L"]}]},
     "hazop_ko": "수위 증가·감소 편차의 감지 수단",
     "basis_level": "general",
     "basis_ko": "수위를 다루는 탱크·용기에는 수위 계측을 두는 설계 관행. 측정변수 L은 ISA 태그 첫 글자에서 읽음"},
    {"id": "E04", "version": 1, "label_ko": "구동 밸브 고장 위치(FO·FC·FL)",
     "target": {"classes": ["motor_operated_valve", "air_operated_valve", "solenoid_valve", "control_valve"]},
     "check": {"type": "property", "properties": ["fail_position"]},
     "hazop_ko": "구동 공기·전원 상실 편차의 결과 판단",
     "basis_level": "general",
     "basis_ko": "구동 밸브는 구동원을 잃었을 때의 위치가 정해져 있어야 함. DEXPI 2.0.1도 고장 동작을 별도 속성으로 둠"},
    {"id": "E05", "version": 1, "label_ko": "구동 밸브 구동원(공기·전원) 의존 관계",
     "target": {"classes": ["motor_operated_valve", "air_operated_valve", "solenoid_valve", "control_valve"]},
     "check": {"type": "relation", "relations": ["depends_on"]},
     "hazop_ko": "지원계통 상실 원인, 공통원인 검토",
     "basis_level": "general",
     "basis_ko": "구동 밸브는 계기용 공기 또는 전원에 의존함. 구동기 관계(actuated_by)는 아직 레지스트리에 없어 depends_on으로만 찾음"},
    {"id": "E06", "version": 1, "label_ko": "안전밸브 설정압력과 보호 대상 설계압력",
     "target": {"classes": ["psv", "relief_valve"]},
     "check": {"type": "compare", "property": "set_pressure", "op": "<=",
               "other": {"relations": ["has_endpoint"], "hops": 3, "stop_at": ["equipment"], "classes": ["equipment"],
                         "properties": ["design_pressure_max", "design_pressure"]}},
     "hazop_ko": "보호수단 적정성 확인 질문(판정은 사람)",
     "basis_level": "general",
     "basis_ko": "안전밸브 설정압력은 보호 대상 설계압력 이하여야 한다는 설계 한계(정보통합관리 '설계 한계' 행). 단위·압력 기준이 다르면 비교하지 않음"},
    {"id": "E07", "version": 1, "label_ko": "경보·스위치 기능 계기 설정치",
     "target": {"classes": ["instrument"], "where": {"property": "functions", "contains_any": ["A", "S"]}},
     "check": {"type": "relation", "relations": ["has_setpoint"]},
     "hazop_ko": "경보·트립 보호수단의 작동점",
     "basis_level": "secondary",
     "basis_ko": "ISA-5.1 기능 문자 A(경보)·S(스위치)는 설정치가 있는 기능을 뜻함(문자 의미는 2차 출처)"},
    {"id": "E08", "version": 1, "label_ko": "제어 루프 완결(측정 계기 → 제어기 → 최종제어요소)",
     "target": {"classes": ["controller"]},
     "check": {"type": "neighbor", "relations": ["signal_connection"], "hops": 1,
               "need": [{"classes": ["instrument"]}, {"classes": ["valve"]}]},
     "hazop_ko": "제어 실패 원인 편차",
     "basis_level": "general",
     "basis_ko": "제어기는 측정 계기에서 신호를 받아 최종제어요소(밸브)로 내보냄(정보통합관리 '제어루프' 행). 신호 방향은 보지 않음"}
  ]
}
